# Doxygen as the docs site's parser of the public headers (DAOLib #49): it
# reads them and writes XML, and tools/doxygen_xml.py turns that into the
# site's API pages, which Jekyll builds with the rest (docs/_config.yml).
# tools/build_docs.py runs it from the repository's root, where these paths
# start, and sets OUTPUT_DIRECTORY and WARN_LOGFILE.
#
# What a plugin includes is documented: src/dao/*.h. What is the library's
# own is not: src/dao/core (its logic, tested headless), src/dao/generated
# (the script API's thousand functions), Addresses.h (the address IDs), and
# the detail and anonymous namespaces. The headers' comments are plain //
# prose; tools/doxygen_filter.py turns them into Doxygen's forms as they are
# read, so the sources keep their style. docs/namespaces.dox gives each
# namespace its line.

PROJECT_NAME           = "DAOLib"
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = . src/
# The same file names on Linux as on Windows, so a build reads the same on
# both.
CASE_SENSE_NAMES       = NO
STRIP_FROM_INC_PATH    = src/
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO

INPUT                  = docs/namespaces.dox \
                         src/dao
FILE_PATTERNS          = *.h *.dox
RECURSIVE              = NO
EXCLUDE                = src/dao/Addresses.h \
                         src/dao/core \
                         src/dao/generated
EXCLUDE_SYMBOLS        = detail \
                         dao::detail \
                         *::detail \
                         *::@*
FILTER_PATTERNS        = *.h="python tools/doxygen_filter.py"
FILTER_SOURCE_FILES    = NO

SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src
